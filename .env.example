# Variables usadas por docker-compose.yml. Copiar como .env y reemplazar secretos.
MYSQL_ROOT_PASSWORD=CAMBIAR_CONTRASENA_ROOT
DB_USER=safewalk_user
DB_PASSWORD=CAMBIAR_CONTRASENA_APLICACION
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES
JWT_EXPIRES=2h
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000
CORS_ORIGIN=https://safewalku.online,https://www.safewalku.online
APP_BIND=127.0.0.1
APP_PORT=8080
# Clave del panel de OpenRouteService. Solo la usa el backend; nunca colocarla en VITE_*.
OPENROUTESERVICE_API_KEY=
ROUTING_TIMEOUT_MS=8000
