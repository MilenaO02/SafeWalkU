# Dependencias
frontend/node_modules/
backend/node_modules/

# Compilados
frontend/dist/
backend/dist/

# Variables privadas
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*
.env
.env.*

# Permitir archivos de ejemplo
!frontend/.env.example
!backend/.env.example
!.env.example

# Configuración y credenciales de despliegue (nunca versionar)
frontend/public/map-config.js
frontend/dist/map-config.js
*.pem
*.p12
*.key

# Logs
*.log
npm-debug.log*

# Archivos subidos durante la ejecución
backend/uploads/*
!backend/uploads/.gitkeep
backups/

# Editor y sistema
.vscode/
.DS_Store
Thumbs.db

# Ignorar carpeta docs y archivos markdown en la raíz (excepto MANUAL_USUARIO.md)
docs/
/*.md
!MANUAL_USUARIO.md
