PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CAMBIAR_CONTRASENA
DB_NAME=safewalku
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000
# En produccion: secreto aleatorio de 64 caracteres o mas. No se debe versionar.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES
JWT_EXPIRES=2h
CORS_ORIGIN=http://localhost:5173,https://localhost:5173
# Clave restringida por API para Routes API; nunca se expone al frontend.
GOOGLE_MAPS_SERVER_API_KEY=
# Clave restringida exclusivamente a Places API (New) para el proxy autenticado.
GOOGLE_PLACES_API_KEY=
# Referer permitido por la restricción de la clave de Places.
GOOGLE_PLACES_REFERRER=https://safewalku.online/
ROUTING_TIMEOUT_MS=8000
