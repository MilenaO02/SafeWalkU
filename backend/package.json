{
  "name": "safewalk-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend SafeWalk",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "npm run build && node scripts/export-openapi.mjs",
    "validate:openapi": "npm run build && node scripts/validate-openapi.mjs",
    "backup:before-demo-cleanup": "node scripts/backup-database.mjs",
    "migrate:phase4": "node scripts/migrate-phase4.mjs",
    "migrate:routes": "node scripts/migrate-route-geometry.mjs",
    "audit:offline": "npm audit --offline --audit-level=high",
    "test": "npm run typecheck && npm run build",
    "test:routes": "npm run build && node --test dist/services/route-selection.test.js dist/services/risk-zone-safety.test.js"
  },
  "keywords": [],
  "author": "Milena Ordoñez",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^9.0.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.10.1",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.7.2"
  }
}
