# ─────────────────────────────────────────────────────────────────────────────
# SafeWalk U — Frontend environment variables
# Copy this file to .env.local (development) or .env.production (production)
# and fill in the real values. Never commit .env.local / .env.production.
# ─────────────────────────────────────────────────────────────────────────────

# URL of the Express backend API (no trailing slash).
# In development the Vite dev-server proxy rewrites /api → localhost:3000/api,
# so you can leave this as /api.
# In production set the full origin, e.g. https://api.safewalk.uide.edu.ec/api
VITE_API_URL=/api

# Google Maps JavaScript API key (browser-restricted).
# Used ONLY to load the Maps JS SDK for rendering the map tiles.
# All Places/Directions API calls are proxied through the backend so this
# key only needs "Maps JavaScript API" enabled and an HTTP referrer restriction.
VITE_GOOGLE_MAPS_API_KEY=

# (Optional) Google Maps Map ID for Cloud-Based Map Styling.
# Leave as DEMO_MAP_ID during development.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
