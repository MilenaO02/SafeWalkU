# Configuración del servidor MCP SafeWalk U
# URL base de la API REST de SafeWalk U en producción o desarrollo local
SAFEWALK_API_BASE_URL=https://safewalku.online/api

# Token JWT de autenticación emitido por SafeWalk U (/api/auth/login)
# NUNCA subir el token real a Git
SAFEWALK_API_TOKEN=tu_token_jwt_aqui

# Nivel de log para diagnósticos en stderr (info | warn | error | debug)
LOG_LEVEL=info
