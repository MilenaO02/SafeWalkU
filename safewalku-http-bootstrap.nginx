# Configuracion temporal para obtener el primer certificado con Certbot.
# Instalar antes de safewalku.nginx y retirar despues de emitir el certificado.
server {
    listen 80;
    listen [::]:80;
    server_name safewalku.online www.safewalku.online;

    root /var/www/safewalku/dist;
    index index.html;

    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /uploads/ {
        alias /var/www/safewalku/backend/uploads/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
