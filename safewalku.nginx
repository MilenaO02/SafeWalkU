# /etc/nginx/sites-available/safewalku
# Docker publica toda la aplicacion solamente en 127.0.0.1:8080.
server {
    listen 80;
    listen [::]:80;
    server_name safewalku.online www.safewalku.online;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://safewalku.online$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name safewalku.online www.safewalku.online;

    ssl_certificate /etc/letsencrypt/live/safewalku.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/safewalku.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10M;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 15s;
        proxy_read_timeout 60s;
    }

    access_log /var/log/nginx/safewalku_access.log;
    error_log /var/log/nginx/safewalku_error.log;
}
